android_app {
    name: "LosSetupWizard",

    srcs: ["src/**/*.java"],

    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    privapp_allowlist: "org.los.setupwizard.xml",
    platform_apis: true,

    overrides: ["Provision"],

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },

    static_libs: [
        "androidx.activity_activity",
        "SettingsLib",
        "setupcompat",
        "setupdesign",
        "SystemUISharedLib",
        "org.lineageos.platform.internal",
    ],

    libs: ["telephony-common"],

    aaptflags: [
        "--rename-manifest-package", "com.android.setupwizard",
    ],
}
